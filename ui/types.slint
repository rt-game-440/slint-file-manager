// 界面与 Rust 之间共享的数据类型。

// 内容区状态：加载中、正常、空目录与几类错误要能区分。
export enum ContentState { loading, ready, empty, not-found, access-denied, not-a-folder, failed }

export enum ViewMode { grid, list }

export enum SortKey { name, modified, size, kind }

// 键盘移动方向（由 Rust 计算目标项）
export enum NavKey { left, right, up, down, home, end, page-up, page-down }

// 文件列表中的一项。所有文字来自真实元数据。
export struct FileItem {
    name: string,
    kind-text: string,
    size-text: string,
    date-text: string,
    is-dir: bool,
    icon: string,
    selected: bool,
}

// 路径导航中的一段；对应的完整路径保存在 Rust 侧。
export struct Crumb {
    label: string,
}

// 标签带中的一个浏览标签。
export struct TabInfo {
    title: string,
    // 是否为所在面板当前显示的标签
    current: bool,
    // 位置读取失败（磁盘未连接、路径已删除、无权限等）：标签保留，用警示图标标出
    unavailable: bool,
}

// 一个浏览面板当前标签的显示状态（Rust 写入）。条目、路径分段与标签列表另用模型传入。
export struct PaneView {
    tab-index: int,
    tab-count: int,
    state: ContentState,
    error-detail: string,
    view: ViewMode,
    sort-key: SortKey,
    sort-ascending: bool,
    location-text: string,
    cursor-index: int,
    can-back: bool,
    can-forward: bool,
    can-up: bool,
}
