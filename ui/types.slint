// 界面与 Rust 之间共享的数据类型。

// 内容区状态：加载中、正常、空目录与几类错误要能区分。
export enum ContentState { loading, ready, empty, not-found, access-denied, not-a-folder, failed }

export enum ViewMode { grid, list }

export enum SortKey { name, modified, size, kind }

// 键盘移动方向（由 Rust 计算目标项）
export enum NavKey { left, right, up, down, home, end, page-up, page-down }

// 网格中一项的缩略图状态（Issue #10）：none 不生成（文件夹、非图片、列表视图）；loading 排队或生成中；
// ready 已有缩略图；failed 无法生成（损坏、不支持、超限、云端占位）；timeout 超过 2 秒仍未完成（之后若成功会补上）。
// failed／timeout 都显示类型图标，不弹提示。
export enum ThumbState { none, loading, ready, failed, timeout }

// 大图预览（Issue #13）的状态：loading 首次打开、尚无图像；ready 有图像；failed 无法预览（损坏、过大、云端占位……）。
export enum PreviewState { loading, ready, failed }

// 云盘状态标记（Issue #14，OneDrive／iCloud）：none 不在云盘；online 仅在线（未下载）；unavailable 仅在线但同步客户端不可用；
// local 本地可用（已下载，可被释放）；pinned 始终保留在本设备。状态来自云文件 API，不只看属性位。
export enum CloudBadge { none, online, unavailable, local, pinned }

export global CloudText {
    // 无障碍描述与 harness 断言用的文字
    public pure function text(b: CloudBadge) -> string {
        if (b == CloudBadge.online) { return "仅在线（未下载到本机）"; }
        if (b == CloudBadge.unavailable) { return "仅在线，同步客户端当前不可用，暂时无法下载"; }
        if (b == CloudBadge.local) { return "本地可用（已下载，空间不足时可被释放）"; }
        if (b == CloudBadge.pinned) { return "始终保留在本设备"; }
        return "";
    }
}

// 文件列表中的一项。所有文字来自真实元数据。
export struct FileItem {
    name: string,
    kind-text: string,
    size-text: string,
    date-text: string,
    is-dir: bool,
    icon: string,
    selected: bool,
    thumb-state: ThumbState,
    thumb: image,
    // 正在重命名：名称处显示输入框
    editing: bool,
    // 已被“剪切”：变淡，粘贴后才会真正移动
    cut: bool,
    // 拖放的当前目标文件夹：高亮
    drop-target: bool,
    // 云盘状态（不在云盘为 none）
    cloud: CloudBadge,
}

// 窗口坐标命中的面板与条目（-1 表示不在任何面板／不在任何条目上）。
export struct DropHit {
    pane: int,
    index: int,
}

// 条目上的指针阶段，用来识别拖放：按下、移动（按住时）、松开、被取消。
export enum DragPhase { down, move, up, cancel }

// 重命名输入框与 Rust 之间的通道（同一时刻只有一个正在编辑的条目）。
export global RenameBus {
    in-out property <string> text;
    // 名称不合法或重名时的原因（非空时输入框为红色边框，Rust 同时写入状态栏）
    in property <string> error;
    // 默认选中的范围：从 0 到该字节偏移（文件不含扩展名）
    in property <int> select-end;
    // 第二个参数：是否由失去焦点触发（Enter 为 false）
    callback commit(string, bool);
    callback cancel();
}

// 拖放进行时的视觉状态（Rust 写入）：跟随指针的小标签、提示文字与目标高亮。
export global DragBus {
    in property <bool> active;
    in property <length> x;
    in property <length> y;
    // 被拖的内容（“3 个项目”或文件名）
    in property <string> label;
    // 放下将发生的事（“复制到 文档”“移动到 下载”“不可放置：……”），与实际执行的操作一致
    in property <string> hint;
    in property <bool> hint-ok;
    // 目标面板；target-index < 0 表示放进该面板当前文件夹，否则放进该行的文件夹
    in property <int> target-pane: -1;
    in property <int> target-index: -1;
}

// 路径导航中的一段；对应的完整路径保存在 Rust 侧。
export struct Crumb {
    label: string,
}

// 标签带中的一个浏览标签。
export struct TabInfo {
    title: string,
    // 是否为所在面板当前显示的标签
    current: bool,
    // 位置读取失败（磁盘未连接、路径已删除、无权限等）：标签保留，用警示图标标出
    unavailable: bool,
}

// 一个浏览面板当前标签的显示状态（Rust 写入）。条目、路径分段与标签列表另用模型传入。
export struct PaneView {
    tab-index: int,
    tab-count: int,
    state: ContentState,
    error-detail: string,
    view: ViewMode,
    sort-key: SortKey,
    sort-ascending: bool,
    location-text: string,
    cursor-index: int,
    can-back: bool,
    can-forward: bool,
    can-up: bool,
    // 当前标签位置是回收站（虚拟位置）：列表显示“删除日期／原位置”，面板顶部有还原条
    recycle: bool,
    // 本面板当前标签的已选数量
    selected-count: int,
}

// 侧栏的一行。标题行（header）只是分组小标题；收藏行 removable 时悬停显示“×”。
export struct SidebarEntry {
    id: string,
    label: string,
    icon: string,
    enabled: bool,
    header: bool,
    // 失效的收藏：警示图标与灰字，说明在 description 里
    warn: bool,
    description: string,
    removable: bool,
}

// ---------- 搜索（Issue #11） ----------

// 搜索面板的阶段：扫描中、完成（有结果）、完成无结果、已取消、范围不可访问
export enum SearchPhase { scanning, done, empty, cancelled, unavailable }

// 提示条的类别：无、提示（信息）、警告（增强不可用等）
export enum SearchNotice { none, info, warn }

// 搜索结果的一行。完整路径保存在 Rust 侧。
export struct SearchItem {
    name: string,
    // 所在目录（完整路径）
    location: string,
    icon: string,
    is-dir: bool,
    selected: bool,
    // 结果已过期：文件已被删除或所在磁盘已移除（尝试打开时才发现）
    missing: bool,
}

// 搜索面板的显示状态（Rust 写入）。
export struct SearchView {
    // 面板是否显示（搜索进行中或有结果）
    active: bool,
    phase: SearchPhase,
    // 范围：false 当前目录及子目录，true 全盘
    scope-all: bool,
    // 范围的文字说明（含具体目录或磁盘列表）
    scope-text: string,
    // 状态行：扫描进度、结果数、权限跳过等
    status-text: string,
    // 当前采用的搜索能力说明
    backend-text: string,
    notice: SearchNotice,
    notice-text: string,
    count: int,
    selected: int,
    // 有选中项，可打开、可定位
    can-act: bool,
}
