// 统一细线图标：24×24 视图框内的 SVG 路径，由本项目手绘，不依赖外部图标资产。
// 图标名与 src/browse/format.rs 的 icon_name 保持一致。
import { Theme } from "theme.slint";

export global IconPaths {
    public pure function get(name: string) -> string {
        if (name == "back") { return "M19 12 H5 M11 6 L5 12 L11 18"; }
        if (name == "forward") { return "M5 12 H19 M13 6 L19 12 L13 18"; }
        if (name == "up") { return "M12 19 V5 M6 11 L12 5 L18 11"; }
        if (name == "refresh") { return "M19.4 9 A8 8 0 1 0 20 13.5 M20 4.5 V9 H15.5"; }
        if (name == "grid") { return "M4.5 4.5 H10 V10 H4.5 Z M14 4.5 H19.5 V10 H14 Z M4.5 14 H10 V19.5 H4.5 Z M14 14 H19.5 V19.5 H14 Z"; }
        if (name == "list") { return "M9 6.5 H20 M9 12 H20 M9 17.5 H20 M4.5 6.5 H5.5 M4.5 12 H5.5 M4.5 17.5 H5.5"; }
        if (name == "sort") { return "M8 4.5 V19.5 M4.5 8 L8 4.5 L11.5 8 M16 19.5 V4.5 M12.5 16 L16 19.5 L19.5 16"; }
        if (name == "search") { return "M10.5 4 A6.5 6.5 0 1 0 10.5 17 A6.5 6.5 0 1 0 10.5 4 Z M15.5 15.5 L20 20"; }
        if (name == "plus") { return "M12 5 V19 M5 12 H19"; }
        if (name == "copy") { return "M8.5 8.5 H19.5 V20 H8.5 Z M5 15.5 V4 H15.5"; }
        if (name == "cut") { return "M7.5 4 L16.5 15.5 M16.5 4 L7.5 15.5 M5 18 A2 2 0 1 0 9 18 A2 2 0 1 0 5 18 Z M15 18 A2 2 0 1 0 19 18 A2 2 0 1 0 15 18 Z"; }
        if (name == "paste") { return "M8.5 5 H15.5 V8 H8.5 Z M8.5 6.5 H6 V20.5 H18 V6.5 H15.5 M9 12 H15 M9 15.5 H15"; }
        if (name == "rename") { return "M4.5 19.5 L5.5 15 L15.5 5 L19 8.5 L9 18.5 Z M13.5 7 L17 10.5"; }
        if (name == "tab-close") { return "M7.5 7.5 L16.5 16.5 M16.5 7.5 L7.5 16.5"; }
        if (name == "split") { return "M4 5 H20 V19 H4 Z M12 5 V19"; }
        if (name == "home") { return "M4 11 L12 4 L20 11 M6.5 9 V20 H17.5 V9 M10 20 V14.5 H14 V20"; }
        if (name == "star") { return "M12 3.5 L14.6 8.9 L20.5 9.7 L16.2 13.8 L17.3 19.7 L12 16.9 L6.7 19.7 L7.8 13.8 L3.5 9.7 L9.4 8.9 Z"; }
        if (name == "computer") { return "M3.5 5 H20.5 V16 H3.5 Z M9 20 H15 M12 16 V20"; }
        if (name == "cloud") { return "M7 18.5 H17.5 A4 4 0 0 0 17.8 10.5 A5.5 5.5 0 0 0 7 11.2 A3.7 3.7 0 0 0 7 18.5 Z"; }
        if (name == "drive") { return "M4 14.5 H20 V19 H4 Z M5.5 14.5 L7.5 6 H16.5 L18.5 14.5 M16.5 16.75 H16.6"; }
        if (name == "usb") { return "M12 20 V6 M12 6 L9.5 8.5 M12 6 L14.5 8.5 M12 13 L8 10.5 V8.5 M12 15 L16 12.5 V10.5 M7 8.5 H9 V6.5 H7 Z M15 10.5 A1.2 1.2 0 1 0 17.4 10.5 A1.2 1.2 0 1 0 15 10.5 Z"; }
        if (name == "trash") { return "M4 7 H20 M9.5 7 V4.5 H14.5 V7 M6 7 L7 20 H17 L18 7 M10 11 V16 M14 11 V16"; }
        if (name == "trash-x") { return "M4 7 H20 M9.5 7 V4.5 H14.5 V7 M6 7 L7 20 H17 L18 7 M9.5 11 L14.5 16 M14.5 11 L9.5 16"; }
        if (name == "restore") { return "M5 12 A7 7 0 1 1 8 17.7 M5 12 V6.5 M5 12 H10.5"; }
        if (name == "chevron-right") { return "M9.5 6 L15.5 12 L9.5 18"; }
        if (name == "chevron-down") { return "M6 9.5 L12 15.5 L18 9.5"; }
        if (name == "arrow-up") { return "M12 18 V6 M7 11 L12 6 L17 11"; }
        if (name == "arrow-down") { return "M12 6 V18 M7 13 L12 18 L17 13"; }
        if (name == "more") { return "M5 12 A1.3 1.3 0 1 0 7.6 12 A1.3 1.3 0 1 0 5 12 Z M10.7 12 A1.3 1.3 0 1 0 13.3 12 A1.3 1.3 0 1 0 10.7 12 Z M16.4 12 A1.3 1.3 0 1 0 19 12 A1.3 1.3 0 1 0 16.4 12 Z"; }
        if (name == "check") { return "M5 12.5 L10 17 L19 7"; }
        if (name == "win-min") { return "M6.5 12 H17.5"; }
        if (name == "win-max") { return "M6.5 6.5 H17.5 V17.5 H6.5 Z"; }
        if (name == "win-restore") { return "M6 9 H15 V18 H6 Z M9 9 V6 H18 V15 H15"; }
        if (name == "win-close") { return "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5"; }
        if (name == "lock") { return "M6 11 H18 V20 H6 Z M8.5 11 V8 A3.5 3.5 0 0 1 15.5 8 V11 M12 14.5 V16.5"; }
        if (name == "warning") { return "M12 4 L21 19.5 H3 Z M12 10 V14 M12 16.8 V17"; }
        if (name == "folder-missing") { return "M3 6.5 A1.5 1.5 0 0 1 4.5 5 H9.25 L11.25 7 H19.5 A1.5 1.5 0 0 1 21 8.5 V17.5 A1.5 1.5 0 0 1 19.5 19 H4.5 A1.5 1.5 0 0 1 3 17.5 Z M10 11 L14 15 M14 11 L10 15"; }
        if (name == "folder") { return "M3 6.5 A1.5 1.5 0 0 1 4.5 5 H9.25 L11.25 7 H19.5 A1.5 1.5 0 0 1 21 8.5 V17.5 A1.5 1.5 0 0 1 19.5 19 H4.5 A1.5 1.5 0 0 1 3 17.5 Z M3 9.5 H21"; }
        if (name == "file-text") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M8.75 12 H16 M8.75 15 H16 M8.75 18 H13"; }
        if (name == "file-image") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M8.5 18.5 L11 15.5 L12.75 17.25 L14.25 15.75 L16.5 18.5 Z M9 12 A1.1 1.1 0 1 0 11.2 12 A1.1 1.1 0 1 0 9 12 Z"; }
        if (name == "file-video") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M10.5 12.25 L15 15 L10.5 17.75 Z"; }
        if (name == "file-audio") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M12.5 17.5 V11.5 L15.5 11 M12.5 17.5 A1.5 1.5 0 1 1 9.5 17.5 A1.5 1.5 0 1 1 12.5 17.5 Z"; }
        if (name == "file-archive") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M11 3.5 V5 M12.5 5 V6.5 M11 6.5 V8 M12.5 8 V9.5 M10.75 11.5 H12.75 V14.5 H10.75 Z"; }
        if (name == "file-app") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75 M8.75 12 H16 V18.5 H8.75 Z M8.75 14 H16"; }
        if (name == "file") { return "M6 2.75 H13.75 L18.75 7.75 V21.25 H6 Z M13.75 2.75 V7.75 H18.75"; }
        return "M12 12 L12 12";
    }
}

// 细线图标。图标本身不参与无障碍树，名称由所在控件的 accessible-label 表达。
export component Icon inherits Rectangle {
    in property <string> name;
    in property <brush> tint: Theme.text;
    in property <brush> fill-color: transparent;
    in property <length> size: Theme.icon-s;
    in property <length> line-width: 1.5px;
    width: root.size;
    height: root.size;
    accessible-role: none;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: IconPaths.get(root.name);
        stroke: root.tint;
        stroke-width: root.line-width;
        fill: root.fill-color;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
