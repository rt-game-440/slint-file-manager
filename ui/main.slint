// 主窗口：A2 风格的融合顶部（标题 + 工具栏 + 右上窗口控制）、浅灰侧栏、左右两个浏览面板（可切为单栏）与状态栏。
// 标识约定见 docs/debug-harness.md：元素 id 用 kebab-case，可交互元素同时设置 accessible-label；
// 窗口根组件的 out 属性供 harness 读取状态。
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { IconButton, WindowButton, MenuRow } from "controls.slint";
import { BrowserPane } from "browser-pane.slint";
import { ModalDialog } from "dialog.slint";
import { ContentState, ViewMode, SortKey, NavKey, FileItem, Crumb, TabInfo, PaneView, SidebarEntry } from "types.slint";

export { Theme, ContentState, ViewMode, SortKey, NavKey, FileItem, Crumb, TabInfo, PaneView, SidebarEntry }

component SidebarRow inherits Rectangle {
    in property <SidebarEntry> entry;
    in property <bool> current;
    callback clicked();
    callback removed();

    height: 36px * Theme.text-scale;
    border-radius: Theme.radius;
    background: root.current ? Theme.accent-soft : (root.entry.enabled && (ta.has-hover || x-ta.has-hover)) ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.entry.label;
    accessible-enabled: root.entry.enabled;
    accessible-description: root.entry.description;
    accessible-checkable: true;
    accessible-checked: root.current;
    accessible-action-default => {
        if root.entry.enabled {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.entry.removable ? 30px : 6px;
        spacing: 10px;

        Rectangle {
            width: Theme.icon-s;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.entry.icon;
                tint: !root.entry.enabled ? Theme.text-disabled : root.entry.warn ? Theme.warning : root.current ? Theme.accent : Theme.text;
            }
        }

        Text {
            text: root.entry.label;
            color: !root.entry.enabled || root.entry.warn ? Theme.text-disabled : Theme.text;
            font-size: Theme.font + 1px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.entry.enabled;
        clicked => {
            root.clicked();
        }
    }

    // 取消收藏：悬停时显现（元素始终存在，键盘与无障碍可达）
    remove-button := Rectangle {
        visible: root.entry.removable;
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        opacity: (ta.has-hover || x-ta.has-hover) ? 1 : 0;
        background: x-ta.has-hover ? Theme.pressed : transparent;
        accessible-role: button;
        accessible-label: "取消收藏 " + root.entry.label;
        accessible-action-default => {
            root.removed();
        }
        animate opacity { duration: 90ms; }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: "tab-close";
            size: 14px;
            tint: Theme.text-secondary;
        }

        x-ta := TouchArea {
            clicked => {
                root.removed();
            }
        }
    }
}

// 侧栏分组小标题。
component SidebarHeader inherits Rectangle {
    in property <string> label;
    height: 28px * Theme.text-scale;
    accessible-role: text;
    accessible-label: root.label;

    Text {
        x: 12px;
        y: parent.height - self.height - 3px;
        text: root.label;
        color: Theme.text-secondary;
        font-size: Theme.font - 1px;
        font-weight: 600;
    }
}

export component MainWindow inherits Window {
    title: "文件管理器";
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.sidebar-bg;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: Theme.font;
    init => {
        Palette.color-scheme = ColorScheme.light;
        left-pane.focus-content();
    }

    // ---------- 浏览面板状态（Rust 写入，harness 读取） ----------
    // 双栏时两个面板同时显示；单栏时只显示活动面板，另一个面板的状态保留在 Rust 一侧
    in property <bool> split: true;
    in property <int> active-pane: 0;
    in property <PaneView> left-view;
    in property <PaneView> right-view;
    in property <[FileItem]> left-items;
    in property <[FileItem]> right-items;
    in property <[Crumb]> left-crumbs;
    in property <[Crumb]> right-crumbs;
    in property <[TabInfo]> left-tabs;
    in property <[TabInfo]> right-tabs;
    in property <int> selected-count;
    in property <string> status-text;
    in property <string> status-message;
    // 侧栏当前项 id（位置与侧栏入口一致时高亮）
    in property <string> sidebar-current;
    // 侧栏的位置入口（主目录、收藏、磁盘、云盘），Rust 生成；回收站入口见下方静态列表
    in property <[SidebarEntry]> sidebar-places;
    // 活动面板的当前位置是否已收藏
    in property <bool> current-favorite;
    // 状态栏提示是否为成功／普通信息（false 为警示红：失败、部分完成、被拒绝）
    in property <bool> status-message-ok: false;
    // 应用内模态对话框（删除确认、操作结果）；cancel-label 为空时只有确定按钮
    in property <bool> dialog-visible: false;
    in property <string> dialog-title;
    in property <string> dialog-body;
    in property <string> dialog-confirm-label;
    in property <string> dialog-cancel-label;
    in property <bool> dialog-danger: false;
    in property <int> dialog-token;

    // 工具栏与键盘作用于活动面板
    property <PaneView> active-view: root.active-pane == 0 ? root.left-view : root.right-view;

    // harness 导出的状态（均为活动面板的值）
    out property <int> item-count: root.active-pane == 0 ? root.left-items.length : root.right-items.length;
    out property <ContentState> content-state: root.active-view.state;
    out property <ViewMode> view: root.active-view.view;
    out property <SortKey> sort-key: root.active-view.sort-key;
    out property <bool> sort-ascending: root.active-view.sort-ascending;
    out property <int> cursor-index: root.active-view.cursor-index;
    out property <bool> can-back: root.active-view.can-back;
    out property <bool> can-forward: root.active-view.can-forward;
    out property <bool> can-up: root.active-view.can-up;
    out property <bool> editing-address: root.active-pane == 0 ? left-pane.editing-address : right-pane.editing-address;
    out property <string> focus-area: (left-pane.content-focused || right-pane.content-focused) ? "content" : (left-pane.address-focused || right-pane.address-focused) ? "address" : "none";
    // 键盘焦点所在的面板（-1 为不在任何面板）
    out property <int> focused-pane: (left-pane.content-focused || left-pane.address-focused) ? 0 : (right-pane.content-focused || right-pane.address-focused) ? 1 : -1;

    // ---------- 事件（Rust 处理；面板相关的第一个参数是面板编号 0／1） ----------
    callback navigate-to(int, string);
    callback go-back(int);
    callback go-forward(int);
    callback go-up(int);
    callback refresh(int);
    callback crumb-clicked(int, int);
    callback item-pointer(int, int, bool, bool);
    callback item-activate(int, int);
    callback background-pointer(int, bool);
    callback context-menu(int, int, length, length, bool);
    callback nav-key(int, NavKey, bool, bool, int, int);
    callback select-all(int);
    callback activate-selection(int);
    callback toggle-cursor(int);
    callback open-location(int);
    // 删除所选：第二个参数为 true 是永久删除（Shift+Delete），否则移到回收站（Delete）
    callback delete-selected(int, bool);
    // 回收站视图：还原所选项目到原位置
    callback restore-selected(int);
    callback dialog-accepted();
    callback dialog-cancelled();
    callback set-sort(int, SortKey, bool);
    callback set-view(int, ViewMode);
    callback tab-clicked(int, int);
    callback tab-close(int, int);
    callback tab-new(int);
    callback tab-cycle(int, int);
    callback tab-number(int, int);
    callback pane-activated(int);
    callback switch-pane();
    callback toggle-split();
    callback sidebar-clicked(string);
    callback sidebar-remove(string);
    callback toggle-favorite();
    callback request-close();

    // 回收站入口（Issue #8 提供）；其余入口见 sidebar-places
    property <[SidebarEntry]> sidebar-entries: [
        { id: "recycle-bin", label: "回收站", icon: "trash", enabled: true, description: "已删除的项目，可还原" },
    ];

    public function begin-edit-address() {
        if (root.active-pane == 0) {
            left-pane.begin-edit-address();
        } else {
            right-pane.begin-edit-address();
        }
    }

    // 把键盘焦点交给指定面板的内容区（Rust 在活动面板变化后调用）
    public function focus-pane(p: int) {
        if (p == 0) {
            left-pane.focus-content();
        } else {
            right-pane.focus-content();
        }
    }

    // 全局快捷键：子元素未处理的按键冒泡到这里。所有面板相关的快捷键都作用于活动面板。
    shortcuts := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.modifiers.alt && e.text == Key.LeftArrow) {
                root.go-back(root.active-pane);
                return accept;
            }
            if (e.modifiers.alt && e.text == Key.RightArrow) {
                root.go-forward(root.active-pane);
                return accept;
            }
            if (e.modifiers.alt && e.text == Key.UpArrow) {
                root.go-up(root.active-pane);
                return accept;
            }
            if (e.text == Key.Backspace) {
                root.go-back(root.active-pane);
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && (e.text == "d" || e.text == "D")) {
                root.toggle-favorite();
                return accept;
            }
            if (e.text == Key.F5) {
                root.refresh(root.active-pane);
                return accept;
            }
            if ((e.text == Key.F4 && !e.modifiers.control) || (e.modifiers.control && (e.text == "l" || e.text == "L")) || (e.modifiers.alt && (e.text == "d" || e.text == "D"))) {
                root.begin-edit-address();
                return accept;
            }
            // ---- 标签（浏览器习惯） ----
            if (e.modifiers.control && (e.text == "t" || e.text == "T") && !e.modifiers.shift) {
                root.tab-new(root.active-pane);
                return accept;
            }
            if ((e.modifiers.control && (e.text == "w" || e.text == "W")) || (e.modifiers.control && e.text == Key.F4)) {
                root.tab-close(root.active-pane, root.active-view.tab-index);
                return accept;
            }
            if (e.modifiers.control && e.text == Key.Tab && !e.modifiers.shift) {
                root.tab-cycle(root.active-pane, 1);
                return accept;
            }
            if (e.modifiers.control && (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift))) {
                root.tab-cycle(root.active-pane, -1);
                return accept;
            }
            if (e.modifiers.control && e.text == Key.PageDown) {
                root.tab-cycle(root.active-pane, 1);
                return accept;
            }
            if (e.modifiers.control && e.text == Key.PageUp) {
                root.tab-cycle(root.active-pane, -1);
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && e.text.character-count == 1 && e.text.is-float()) {
                root.tab-number(root.active-pane, Math.round(e.text.to-float()));
                return accept;
            }
            // ---- 删除：Delete 移到回收站，Shift+Delete 永久删除（都要先确认） ----
            if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.alt) {
                root.delete-selected(root.active-pane, e.modifiers.shift);
                return accept;
            }
            // ---- 面板与布局 ----
            if (e.text == Key.F6) {
                root.switch-pane();
                return accept;
            }
            if (e.modifiers.control && e.text == "\\") {
                root.toggle-split();
                return accept;
            }
            reject
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // ---------- 侧栏 ----------
                sidebar := Rectangle {
                    width: Theme.sidebar-w;
                    background: Theme.sidebar-bg;

                    VerticalLayout {
                        title-area := Rectangle {
                            height: Theme.toolbar-h;
                            WindowMoveArea {
                                TouchArea {
                                    double-clicked => {
                                        root.maximized = !root.maximized;
                                    }
                                }
                            }

                            Text {
                                x: 20px;
                                text: "文件管理器";
                                color: Theme.text;
                                font-size: Theme.font-title;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        Flickable {
                            vertical-stretch: 1;
                            content-height: nav.preferred-height;

                            nav := VerticalLayout {
                                width: parent.width;
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 8px;
                                spacing: 4px;
                                alignment: start;
                                accessible-role: list;
                                accessible-label: "导航";

                                for s in root.sidebar-places: Rectangle {
                                    height: s.header ? 28px * Theme.text-scale : 36px * Theme.text-scale;

                                    if s.header: SidebarHeader {
                                        label: s.label;
                                    }
                                    if !s.header: SidebarRow {
                                        entry: s;
                                        current: s.id == root.sidebar-current;
                                        clicked => {
                                            root.sidebar-clicked(s.id);
                                        }
                                        removed => {
                                            root.sidebar-remove(s.id);
                                        }
                                    }
                                }

                                for s in root.sidebar-entries: SidebarRow {
                                    entry: s;
                                    current: s.id == root.sidebar-current;
                                    clicked => {
                                        root.sidebar-clicked(s.id);
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.divider;
                }

                VerticalLayout {
                    horizontal-stretch: 1;

                    // ---------- 融合工具栏 ----------
                    toolbar := Rectangle {
                        height: Theme.toolbar-h;
                        background: Theme.chrome-bg;

                        WindowMoveArea {
                            TouchArea {
                                double-clicked => {
                                    root.maximized = !root.maximized;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            // 右侧留出窗口控制按钮的位置
                            padding-right: 3 * 44px + 10px;
                            spacing: 4px;
                            alignment: start;

                            VerticalLayout {
                                alignment: center;
                                sort-button := IconButton {
                                    icon: "sort";
                                    label: "排序方式";
                                    clicked => {
                                        sort-menu.show();
                                    }
                                }
                            }

                            Rectangle {
                                width: 9px;
                                Rectangle {
                                    x: 4px;
                                    width: 1px;
                                    height: 18px;
                                    background: Theme.divider-strong;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                view-grid-button := IconButton {
                                    icon: "grid";
                                    label: "网格视图";
                                    checkable: true;
                                    checked: root.active-view.view == ViewMode.grid;
                                    clicked => {
                                        root.set-view(root.active-pane, ViewMode.grid);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                view-list-button := IconButton {
                                    icon: "list";
                                    label: "列表视图";
                                    checkable: true;
                                    checked: root.active-view.view == ViewMode.list;
                                    clicked => {
                                        root.set-view(root.active-pane, ViewMode.list);
                                    }
                                }
                            }

                            Rectangle {
                                width: 9px;
                                Rectangle {
                                    x: 4px;
                                    width: 1px;
                                    height: 18px;
                                    background: Theme.divider-strong;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                delete-button := IconButton {
                                    icon: "trash";
                                    label: "删除";
                                    enabled: root.active-view.selected-count > 0 && !root.active-view.recycle;
                                    clicked => {
                                        root.delete-selected(root.active-pane, false);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                delete-permanent-button := IconButton {
                                    icon: "trash-x";
                                    label: "永久删除";
                                    danger: true;
                                    enabled: root.active-view.selected-count > 0 && !root.active-view.recycle;
                                    clicked => {
                                        root.delete-selected(root.active-pane, true);
                                    }
                                }
                            }

                            Rectangle {
                                width: 9px;
                                Rectangle {
                                    x: 4px;
                                    width: 1px;
                                    height: 18px;
                                    background: Theme.divider-strong;
                                }
                            }

                            // 双栏入口：双栏／单栏切换。单栏只是隐藏，另一侧的标签与状态原样保留
                            VerticalLayout {
                                alignment: center;
                                split-button := Rectangle {
                                    height: Theme.control-h;
                                    width: split-row.preferred-width;
                                    border-radius: 6px;
                                    background: root.split ? Theme.accent-soft : split-ta.pressed ? Theme.pressed : split-ta.has-hover ? Theme.hover : transparent;
                                    accessible-role: button;
                                    accessible-label: "双栏";
                                    accessible-checkable: true;
                                    accessible-checked: root.split;
                                    accessible-description: root.split ? "当前为双栏，点击切换为单栏" : "当前为单栏，点击恢复双栏";
                                    accessible-action-default => {
                                        root.toggle-split();
                                    }
                                    animate background { duration: 90ms; }

                                    split-row := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: Theme.icon-s;
                                            Icon {
                                                y: (parent.height - self.height) / 2;
                                                name: "split";
                                                tint: root.split ? Theme.accent : Theme.text;
                                            }
                                        }

                                        Text {
                                            text: "双栏";
                                            color: root.split ? Theme.accent : Theme.text;
                                            font-size: Theme.font;
                                            vertical-alignment: center;
                                        }
                                    }

                                    split-ta := TouchArea {
                                        clicked => {
                                            root.toggle-split();
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                width: 9px;
                                Rectangle {
                                    x: 4px;
                                    width: 1px;
                                    height: 18px;
                                    background: Theme.divider-strong;
                                }
                            }

                            // 收藏当前位置（Ctrl+D）：已收藏时为选中外观，再点取消收藏
                            VerticalLayout {
                                alignment: center;
                                favorite-button := IconButton {
                                    icon: "star";
                                    label: "收藏当前位置";
                                    checkable: true;
                                    checked: root.current-favorite;
                                    clicked => {
                                        root.toggle-favorite();
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            // 搜索入口：保留 A2 位置，搜索在 Issue #11 提供，当前为禁用外观
                            VerticalLayout {
                                alignment: center;
                                search-box := Rectangle {
                                    // 空间不足时让搜索框先收窄（最小 48px），不把整个窗口撑宽
                                    preferred-width: 220px * Theme.text-scale;
                                    min-width: 48px;
                                    height: Theme.control-h;
                                    border-radius: Theme.control-h / 2;
                                    background: #f0f1f4;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    accessible-role: text-input;
                                    accessible-label: "搜索";
                                    accessible-enabled: false;
                                    accessible-description: "后续版本提供";

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        spacing: 6px;
                                        Rectangle {
                                            width: Theme.icon-s * 0.9;
                                            Icon {
                                                y: (parent.height - self.height) / 2;
                                                name: "search";
                                                size: Theme.icon-s * 0.9;
                                                tint: Theme.text-disabled;
                                            }
                                        }

                                        Text {
                                            text: "搜索（即将提供）";
                                            color: Theme.text-disabled;
                                            font-size: Theme.font;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }

                        // 右上角窗口控制
                        window-controls := HorizontalLayout {
                            x: parent.width - self.width - 4px;
                            y: 2px;
                            width: self.preferred-width;
                            height: 30px;

                            WindowButton {
                                icon: "win-min";
                                label: "最小化";
                                clicked => {
                                    root.minimized = true;
                                }
                            }

                            WindowButton {
                                icon: root.maximized ? "win-restore" : "win-max";
                                label: root.maximized ? "还原" : "最大化";
                                clicked => {
                                    root.maximized = !root.maximized;
                                }
                            }

                            WindowButton {
                                icon: "win-close";
                                label: "关闭";
                                danger: true;
                                clicked => {
                                    root.request-close();
                                }
                            }
                        }

                        sort-menu := PopupWindow {
                            x: sort-button.absolute-position.x - toolbar.absolute-position.x;
                            y: Theme.toolbar-h - 6px;
                            width: 180px * Theme.text-scale;
                            close-policy: close-on-click-outside;

                            Rectangle {
                                background: Theme.surface;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.divider;
                                drop-shadow-blur: 16px;
                                drop-shadow-offset-y: 4px;
                                drop-shadow-color: #00000022;

                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 1px;

                                    MenuRow {
                                        text: "名称";
                                        checked: root.active-view.sort-key == SortKey.name;
                                        clicked => {
                                            root.set-sort(root.active-pane, SortKey.name, root.active-view.sort-ascending);
                                            sort-menu.close();
                                        }
                                    }

                                    MenuRow {
                                        text: "修改日期";
                                        checked: root.active-view.sort-key == SortKey.modified;
                                        clicked => {
                                            root.set-sort(root.active-pane, SortKey.modified, root.active-view.sort-ascending);
                                            sort-menu.close();
                                        }
                                    }

                                    MenuRow {
                                        text: "类型";
                                        checked: root.active-view.sort-key == SortKey.kind;
                                        clicked => {
                                            root.set-sort(root.active-pane, SortKey.kind, root.active-view.sort-ascending);
                                            sort-menu.close();
                                        }
                                    }

                                    MenuRow {
                                        text: "大小";
                                        checked: root.active-view.sort-key == SortKey.size;
                                        clicked => {
                                            root.set-sort(root.active-pane, SortKey.size, root.active-view.sort-ascending);
                                            sort-menu.close();
                                        }
                                    }

                                    Rectangle {
                                        height: 9px;
                                        Rectangle {
                                            y: 4px;
                                            height: 1px;
                                            background: Theme.divider;
                                        }
                                    }

                                    MenuRow {
                                        text: "递增";
                                        checked: root.active-view.sort-ascending;
                                        clicked => {
                                            root.set-sort(root.active-pane, root.active-view.sort-key, true);
                                            sort-menu.close();
                                        }
                                    }

                                    MenuRow {
                                        text: "递减";
                                        checked: !root.active-view.sort-ascending;
                                        clicked => {
                                            root.set-sort(root.active-pane, root.active-view.sort-key, false);
                                            sort-menu.close();
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------- 浏览面板区：双栏等宽，单栏显示活动面板 ----------
                    // 隐藏的面板保持实例与尺寸（visible: false），滚动位置等界面状态也随之保留。
                    panes-area := Rectangle {
                        vertical-stretch: 1;
                        property <length> pane-w: root.split ? (self.width - 1px) / 2 : self.width;
                        property <length> hidden-w: (self.width - 1px) / 2;

                        left-pane := BrowserPane {
                            x: 0px;
                            y: 0px;
                            height: parent.height;
                            width: (root.split || root.active-pane == 0) ? panes-area.pane-w : panes-area.hidden-w;
                            visible: root.split || root.active-pane == 0;
                            pane-id: 0;
                            pane-name: "左面板";
                            pane-active: root.active-pane == 0;
                            v: root.left-view;
                            items: root.left-items;
                            crumbs: root.left-crumbs;
                            tabs: root.left-tabs;
                            navigate-to(a0, a1) => {
                                root.navigate-to(a0, a1);
                            }
                            go-back(a0) => {
                                root.go-back(a0);
                            }
                            go-forward(a0) => {
                                root.go-forward(a0);
                            }
                            go-up(a0) => {
                                root.go-up(a0);
                            }
                            refresh(a0) => {
                                root.refresh(a0);
                            }
                            crumb-clicked(a0, a1) => {
                                root.crumb-clicked(a0, a1);
                            }
                            item-pointer(a0, a1, a2, a3) => {
                                root.item-pointer(a0, a1, a2, a3);
                            }
                            item-activate(a0, a1) => {
                                root.item-activate(a0, a1);
                            }
                            background-pointer(a0, a1) => {
                                root.background-pointer(a0, a1);
                            }
                            context-menu(a0, a1, a2, a3, a4) => {
                                root.context-menu(a0, a1, a2, a3, a4);
                            }
                            nav-key(a0, a1, a2, a3, a4, a5) => {
                                root.nav-key(a0, a1, a2, a3, a4, a5);
                            }
                            select-all(a0) => {
                                root.select-all(a0);
                            }
                            activate-selection(a0) => {
                                root.activate-selection(a0);
                            }
                            toggle-cursor(a0) => {
                                root.toggle-cursor(a0);
                            }
                            set-sort(a0, a1, a2) => {
                                root.set-sort(a0, a1, a2);
                            }
                            open-location(a0) => {
                                root.open-location(a0);
                            }
                            restore-selected(a0) => {
                                root.restore-selected(a0);
                            }
                            tab-clicked(a0, a1) => {
                                root.tab-clicked(a0, a1);
                            }
                            tab-close(a0, a1) => {
                                root.tab-close(a0, a1);
                            }
                            tab-new(a0) => {
                                root.tab-new(a0);
                            }
                            pane-activated(a0) => {
                                root.pane-activated(a0);
                            }
                        }

                        if root.split: Rectangle {
                            x: panes-area.pane-w;
                            width: 1px;
                            height: parent.height;
                            background: Theme.divider-strong;
                        }

                        right-pane := BrowserPane {
                            x: root.split ? panes-area.pane-w + 1px : 0px;
                            y: 0px;
                            height: parent.height;
                            width: (root.split || root.active-pane == 1) ? panes-area.pane-w : panes-area.hidden-w;
                            visible: root.split || root.active-pane == 1;
                            pane-id: 1;
                            pane-name: "右面板";
                            pane-active: root.active-pane == 1;
                            v: root.right-view;
                            items: root.right-items;
                            crumbs: root.right-crumbs;
                            tabs: root.right-tabs;
                            navigate-to(a0, a1) => {
                                root.navigate-to(a0, a1);
                            }
                            go-back(a0) => {
                                root.go-back(a0);
                            }
                            go-forward(a0) => {
                                root.go-forward(a0);
                            }
                            go-up(a0) => {
                                root.go-up(a0);
                            }
                            refresh(a0) => {
                                root.refresh(a0);
                            }
                            crumb-clicked(a0, a1) => {
                                root.crumb-clicked(a0, a1);
                            }
                            item-pointer(a0, a1, a2, a3) => {
                                root.item-pointer(a0, a1, a2, a3);
                            }
                            item-activate(a0, a1) => {
                                root.item-activate(a0, a1);
                            }
                            background-pointer(a0, a1) => {
                                root.background-pointer(a0, a1);
                            }
                            context-menu(a0, a1, a2, a3, a4) => {
                                root.context-menu(a0, a1, a2, a3, a4);
                            }
                            nav-key(a0, a1, a2, a3, a4, a5) => {
                                root.nav-key(a0, a1, a2, a3, a4, a5);
                            }
                            select-all(a0) => {
                                root.select-all(a0);
                            }
                            activate-selection(a0) => {
                                root.activate-selection(a0);
                            }
                            toggle-cursor(a0) => {
                                root.toggle-cursor(a0);
                            }
                            set-sort(a0, a1, a2) => {
                                root.set-sort(a0, a1, a2);
                            }
                            open-location(a0) => {
                                root.open-location(a0);
                            }
                            restore-selected(a0) => {
                                root.restore-selected(a0);
                            }
                            tab-clicked(a0, a1) => {
                                root.tab-clicked(a0, a1);
                            }
                            tab-close(a0, a1) => {
                                root.tab-close(a0, a1);
                            }
                            tab-new(a0) => {
                                root.tab-new(a0);
                            }
                            pane-activated(a0) => {
                                root.pane-activated(a0);
                            }
                        }
                    }
                }
            }

            // ---------- 状态栏 ----------
            status-bar := Rectangle {
                height: Theme.statusbar-h;
                background: Theme.chrome-bg;

                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 16px;

                    status-label := Text {
                        text: root.status-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: "状态";
                        accessible-value: root.status-text;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    status-message-label := Text {
                        text: root.status-message;
                        color: root.status-message-ok ? Theme.text-secondary : Theme.danger;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: text;
                        accessible-label: "提示";
                        accessible-value: root.status-message;
                    }
                }
            }
        }
    }

    // ---------- 应用内模态对话框 ----------
    if root.dialog-visible: ModalDialog {
        width: root.width;
        height: root.height;
        title: root.dialog-title;
        body: root.dialog-body;
        confirm-label: root.dialog-confirm-label;
        cancel-label: root.dialog-cancel-label;
        danger: root.dialog-danger;
        focus-token: root.dialog-token;
        accepted => {
            root.dialog-accepted();
        }
        cancelled => {
            root.dialog-cancelled();
        }
    }
}
