// 浏览面板：标签带（本单只有一个浏览标签，标签管理见 Issue #6）、路径导航、内容区（网格／列表／状态）。
// 面板状态全部由属性传入、事件以回调传出，便于双栏时实例化两份。
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { IconButton, TextButton } from "controls.slint";
import { FileGrid, FileList } from "file-views.slint";
import { ContentState, ViewMode, SortKey, NavKey, FileItem, Crumb } from "types.slint";

component CrumbButton inherits Rectangle {
    in property <string> text;
    in property <bool> current;
    callback clicked();

    height: Theme.control-h - 4px;
    border-radius: 5px;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: "转到 " + root.text;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            max-width: 240px * Theme.text-scale;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component PathBar inherits Rectangle {
    in property <[Crumb]> crumbs;
    in property <string> location-text;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in property <bool> can-refresh;
    in-out property <bool> editing;
    out property <bool> input-focused: editing && input-focus-probe;
    in-out property <bool> input-focus-probe;
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback crumb-clicked(int);
    callback submit(string);
    callback edit-finished();

    background: Theme.content-bg;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;
        alignment: stretch;

        VerticalLayout {
            alignment: center;
            back-button := IconButton {
                icon: "back";
                label: "后退";
                enabled: root.can-back;
                clicked => {
                    root.go-back();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            forward-button := IconButton {
                icon: "forward";
                label: "前进";
                enabled: root.can-forward;
                clicked => {
                    root.go-forward();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            up-button := IconButton {
                icon: "up";
                label: "上一级";
                enabled: root.can-up;
                clicked => {
                    root.go-up();
                }
            }
        }

        Rectangle {
            width: 8px;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            address-bar := Rectangle {
                height: Theme.control-h;
                border-radius: 6px;
                background: root.editing ? Theme.surface : address-ta.has-hover ? Theme.hover-soft : transparent;
                border-width: root.editing ? 1.5px : 0px;
                border-color: Theme.accent;
                accessible-role: button;
                accessible-label: "地址栏";
                accessible-value: root.location-text;
                accessible-action-default => {
                    root.editing = true;
                }

                // 点击路径分段以外的空白处进入编辑
                address-ta := TouchArea {
                    clicked => {
                        root.editing = true;
                    }
                }

                if !root.editing: crumb-clip := Rectangle {
                    x: 2px;
                    width: parent.width - 4px;
                    clip: true;
                    property <bool> overflow: crumb-row.preferred-width > self.width;
                    property <length> ellipsis-w: 28px * Theme.text-scale;

                    crumb-row := HorizontalLayout {
                        // 路径过长时显示末尾几级：开头放不下的分段整段隐藏（不显示半截文字），用“…”提示
                        x: crumb-clip.overflow ? crumb-clip.width - self.preferred-width : 0px;
                        width: self.preferred-width;
                        spacing: 0px;

                        for c[i] in root.crumbs: Rectangle {
                            // 隐藏的分段仍占位（布局不变），但不绘制、不接收点击
                            visible: !crumb-clip.overflow || crumb-row.x + self.x >= crumb-clip.ellipsis-w;

                            HorizontalLayout {
                                spacing: 0px;
                                if i > 0: Rectangle {
                                    width: Theme.icon-s * 0.75;
                                    Icon {
                                        y: (parent.height - self.height) / 2;
                                        name: "chevron-right";
                                        size: Theme.icon-s * 0.75;
                                        tint: Theme.text-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    CrumbButton {
                                        text: c.label;
                                        current: i == root.crumbs.length - 1;
                                        clicked => {
                                            root.crumb-clicked(i);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if crumb-clip.overflow: Text {
                        x: 6px;
                        text: "…";
                        color: Theme.text-secondary;
                        font-size: Theme.font;
                        vertical-alignment: center;
                    }
                }

                if root.editing: FocusScope {
                    x: 10px;
                    width: parent.width - 20px;
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.edit-finished();
                            return accept;
                        }
                        reject
                    }

                    address-input := TextInput {
                        text: root.location-text;
                        color: Theme.text;
                        font-size: Theme.font;
                        vertical-alignment: center;
                        single-line: true;
                        selection-background-color: Theme.accent-border;
                        selection-foreground-color: Theme.text;
                        accessible-label: "地址";
                        init => {
                            self.focus();
                            self.select-all();
                            root.input-focus-probe = true;
                        }
                        accepted => {
                            root.submit(self.text);
                        }
                        changed has-focus => {
                            root.input-focus-probe = self.has-focus;
                            if (!self.has-focus && root.editing) {
                                root.editing = false;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 4px;
        }

        VerticalLayout {
            alignment: center;
            refresh-button := IconButton {
                icon: "refresh";
                label: "刷新";
                enabled: root.can-refresh;
                clicked => {
                    root.refresh();
                }
            }
        }
    }
}

// 空目录与错误状态的说明面板
component StatePanel inherits Rectangle {
    in property <ContentState> state;
    in property <string> location-text;
    in property <string> error-detail;
    callback retry();
    callback open-location();

    property <string> title: root.state == ContentState.empty ? "此文件夹为空"
        : root.state == ContentState.not-found ? "找不到这个位置"
        : root.state == ContentState.access-denied ? "没有权限访问此文件夹"
        : root.state == ContentState.not-a-folder ? "这是文件，不是文件夹"
        : "无法读取此位置";
    property <string> detail: root.state == ContentState.empty ? ""
        : root.state == ContentState.not-found ? "请检查路径是否正确，或磁盘、网络位置是否已连接。"
        : root.state == ContentState.access-denied ? "Windows 拒绝了读取请求。可以换用有权限的账户，或返回上一个位置。"
        : root.state == ContentState.not-a-folder ? "地址指向一个文件。可以交给默认应用打开。"
        : root.error-detail;
    property <string> icon: root.state == ContentState.empty ? "folder"
        : root.state == ContentState.not-found ? "folder-missing"
        : root.state == ContentState.access-denied ? "lock"
        : root.state == ContentState.not-a-folder ? "file"
        : "warning";

    accessible-role: groupbox;
    accessible-label: root.title;
    accessible-description: root.detail;

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 24px;

        HorizontalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                size: 48px * min(Theme.text-scale, 1.5);
                line-width: 1.3px;
                tint: root.state == ContentState.empty ? Theme.folder : Theme.text-secondary;
                fill-color: root.state == ContentState.empty ? Theme.folder-fill : transparent;
            }
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-heading;
            font-weight: 600;
            horizontal-alignment: center;
        }

        if root.state != ContentState.empty: Text {
            text: root.location-text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: char-wrap;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-secondary;
            font-size: Theme.font;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.state != ContentState.empty: HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            TextButton {
                text: root.state == ContentState.not-a-folder ? "用默认应用打开" : "重试";
                clicked => {
                    if (root.state == ContentState.not-a-folder) {
                        root.open-location();
                    } else {
                        root.retry();
                    }
                }
            }
        }
    }
}

export component BrowserPane inherits Rectangle {
    // ---------- 状态（由 Rust 写入） ----------
    in property <[FileItem]> items;
    in property <int> cursor-index: -1;
    in property <ContentState> state: ContentState.loading;
    in property <string> error-detail;
    in property <ViewMode> view: ViewMode.grid;
    in property <SortKey> sort-key: SortKey.name;
    in property <bool> sort-ascending: true;
    in property <string> location-text;
    in property <string> tab-title;
    in property <[Crumb]> crumbs;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in-out property <bool> editing-address;
    out property <bool> content-focused: content.has-focus;
    out property <bool> address-focused: path-bar.input-focused;

    // ---------- 事件 ----------
    callback navigate-to(string);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback crumb-clicked(int);
    callback item-pointer(int, bool, bool);
    callback item-activate(int);
    callback background-pointer(bool);
    callback nav-key(NavKey, bool, bool, int, int);
    callback select-all();
    callback activate-selection();
    callback toggle-cursor();
    callback sort-clicked(SortKey);
    callback open-location();

    public function focus-content() {
        content.focus();
    }

    public function begin-edit-address() {
        root.editing-address = true;
    }

    forward-focus: content;
    background: Theme.content-bg;

    VerticalLayout {
        // 标签带：保留 A2 的位置；当前只有一个浏览标签，新建／切换标签在 Issue #6 实现
        Rectangle {
            height: Theme.tabstrip-h;
            background: Theme.chrome-bg;

            HorizontalLayout {
                padding-left: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                alignment: start;

                tab-chip := Rectangle {
                    border-radius: 8px;
                    background: Theme.surface;
                    drop-shadow-blur: 3px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #0000000d;
                    accessible-role: tab;
                    accessible-label: "浏览标签 " + root.tab-title;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 6px;

                        Rectangle {
                            width: Theme.icon-s * 0.85;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "folder";
                                size: Theme.icon-s * 0.85;
                                tint: Theme.folder;
                                fill-color: Theme.folder-fill;
                            }
                        }

                        Text {
                            text: root.tab-title;
                            color: Theme.text;
                            font-size: Theme.font;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: 220px * Theme.text-scale;
                        }
                    }
                }
            }
        }

        path-bar := PathBar {
            height: Theme.pathbar-h;
            crumbs: root.crumbs;
            location-text: root.location-text;
            can-back: root.can-back;
            can-forward: root.can-forward;
            can-up: root.can-up;
            can-refresh: root.location-text != "";
            editing <=> root.editing-address;
            go-back => {
                root.go-back();
            }
            go-forward => {
                root.go-forward();
            }
            go-up => {
                root.go-up();
            }
            refresh => {
                root.refresh();
            }
            crumb-clicked(i) => {
                root.crumb-clicked(i);
            }
            submit(text) => {
                root.editing-address = false;
                content.focus();
                root.navigate-to(text);
            }
            edit-finished => {
                root.editing-address = false;
                content.focus();
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        content := FocusScope {
            vertical-stretch: 1;
            key-pressed(e) => {
                if (e.text == Key.LeftArrow) {
                    root.nav-key(NavKey.left, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.RightArrow) {
                    root.nav-key(NavKey.right, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.UpArrow && !e.modifiers.alt) {
                    root.nav-key(NavKey.up, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    root.nav-key(NavKey.down, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.Home) {
                    root.nav-key(NavKey.home, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.End) {
                    root.nav-key(NavKey.end, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.PageUp) {
                    root.nav-key(NavKey.page-up, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.PageDown) {
                    root.nav-key(NavKey.page-down, e.modifiers.shift, e.modifiers.control, root.nav-cols(), root.nav-page());
                    return accept;
                }
                if (e.text == Key.Return) {
                    root.activate-selection();
                    return accept;
                }
                if (e.modifiers.control && (e.text == "a" || e.text == "A")) {
                    root.select-all();
                    return accept;
                }
                if (e.modifiers.control && e.text == " ") {
                    root.toggle-cursor();
                    return accept;
                }
                reject
            }

            Rectangle {
                background: Theme.content-bg;

                file-grid := FileGrid {
                    visible: root.state == ContentState.ready && root.view == ViewMode.grid;
                    items: root.items;
                    cursor-index: root.cursor-index;
                    pane-focused: content.has-focus;
                    item-pointer(i, ctrl, shift) => {
                        content.focus();
                        root.item-pointer(i, ctrl, shift);
                    }
                    item-activate(i) => {
                        root.item-activate(i);
                    }
                    background-pointer(ctrl) => {
                        content.focus();
                        root.background-pointer(ctrl);
                    }
                }

                file-list := FileList {
                    visible: root.state == ContentState.ready && root.view == ViewMode.list;
                    items: root.items;
                    cursor-index: root.cursor-index;
                    pane-focused: content.has-focus;
                    sort-key: root.sort-key;
                    sort-ascending: root.sort-ascending;
                    item-pointer(i, ctrl, shift) => {
                        content.focus();
                        root.item-pointer(i, ctrl, shift);
                    }
                    item-activate(i) => {
                        root.item-activate(i);
                    }
                    background-pointer(ctrl) => {
                        content.focus();
                        root.background-pointer(ctrl);
                    }
                    sort-clicked(k) => {
                        root.sort-clicked(k);
                    }
                }

                state-panel := StatePanel {
                    visible: root.state != ContentState.ready && root.state != ContentState.loading;
                    state: root.state;
                    location-text: root.location-text;
                    error-detail: root.error-detail;
                    retry => {
                        root.refresh();
                    }
                    open-location => {
                        root.open-location();
                    }
                }

                // 加载提示：延迟 150ms 才淡入，快速目录不闪烁；加载结束立即消失
                loading-indicator := Rectangle {
                    opacity: 0;
                    accessible-role: progress-indicator;
                    accessible-label: "正在加载";

                    states [
                        busy when root.state == ContentState.loading: {
                            opacity: 1;
                            in {
                                animate opacity {
                                    delay: 150ms;
                                    duration: 180ms;
                                    easing: ease-out;
                                }
                            }
                        }
                    ]

                    Rectangle {
                        y: 0px;
                        height: 2px;
                        background: Theme.accent-soft;
                        clip: true;

                        if root.state == ContentState.loading: Rectangle {
                            width: parent.width * 0.3;
                            x: parent.width * 1.3 * mod(animation-tick() / 1ms, 1200) / 1200 - parent.width * 0.3;
                            height: 100%;
                            background: Theme.accent;
                        }
                    }

                    Text {
                        text: "正在加载…";
                        color: Theme.text-secondary;
                        font-size: Theme.font;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    pure function nav-cols() -> int {
        return root.view == ViewMode.grid ? file-grid.cols : 1;
    }

    pure function nav-page() -> int {
        return root.view == ViewMode.grid ? file-grid.page-rows : file-list.page-rows;
    }
}
