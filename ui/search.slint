// 搜索：工具栏上的搜索框，以及覆盖在浏览面板区之上的搜索结果面板（Issue #11）。
// 标识约定见 docs/debug-harness.md：可交互元素同时写 id 与 accessible-label。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { TextButton } from "controls.slint";
import { SearchItem, SearchView, SearchPhase, SearchNotice } from "types.slint";

// 工具栏搜索框：输入即搜（Rust 侧防抖），回车立即搜索，Esc 清空并关闭，上下键移动结果选择。
export component SearchBox inherits Rectangle {
    in-out property <string> text;
    in property <bool> active;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();
    callback escape();
    callback nav(int);

    public function focus-input() {
        input.focus();
        input.select-all();
    }

    // 空间不足时让搜索框先收窄，但保留图标与“搜索…”占位（约 7 个字宽），不把整个窗口撑宽（Issue #40）
    preferred-width: 240px * Theme.text-scale;
    min-width: 100px * Theme.text-scale;
    height: Theme.control-h;
    border-radius: Theme.control-h / 2;
    background: input.has-focus || root.active ? Theme.surface : #f0f1f4;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.divider;
    accessible-role: groupbox;
    accessible-label: "搜索框";
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;

        Rectangle {
            width: Theme.icon-s * 0.9;
            Icon {
                y: (parent.height - self.height) / 2;
                name: "search";
                size: Theme.icon-s * 0.9;
                tint: input.has-focus || root.active ? Theme.accent : Theme.text-secondary;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent-border;
                selection-foreground-color: Theme.text;
                accessible-role: text-input;
                accessible-label: "搜索";
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
                key-pressed(e) => {
                    if (e.text == Key.Escape) {
                        root.escape();
                        return accept;
                    }
                    if (e.text == Key.DownArrow) {
                        root.nav(1);
                        return accept;
                    }
                    if (e.text == Key.UpArrow) {
                        root.nav(-1);
                        return accept;
                    }
                    reject
                }
            }

            if root.text == "": Text {
                x: 0px;
                width: parent.width;
                text: root.width < 190px * Theme.text-scale ? "搜索…" : "搜索名称、扩展名或路径";
                color: Theme.text-disabled;
                font-size: Theme.font;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.text != "": clear-button := Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: clear-ta.has-hover ? Theme.pressed : transparent;
            accessible-role: button;
            accessible-label: "清空搜索";
            accessible-action-default => {
                root.escape();
            }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "tab-close";
                size: 12px;
                tint: Theme.text-secondary;
            }

            clear-ta := TouchArea {
                clicked => {
                    root.escape();
                }
            }
        }
    }
}

// 工具栏的搜索范围入口（始终可见，空闲时也能选）：两段式，“当前目录”（含子目录）与“全盘”。
// 无障碍标签带“范围：”前缀，与搜索面板里的同名范围按钮区分。
export component ScopeSegment inherits Rectangle {
    in property <bool> all;
    // 工具栏空间不足（大文字缩放、窄窗口）时折叠为单个切换按钮，点击在两个范围间切换
    in property <bool> compact;
    callback set-scope(bool);

    height: Theme.control-h;
    width: root.compact ? 24px * Theme.text-scale + 22px : row.preferred-width + 2px;
    border-radius: Theme.control-h / 2;
    border-width: 1px;
    border-color: root.compact && root.all ? Theme.accent-border : Theme.divider-strong;
    background: root.compact ? (root.all ? Theme.accent-soft : compact-ta.has-hover ? Theme.hover : Theme.surface) : Theme.surface;
    accessible-role: groupbox;
    accessible-label: "搜索范围";
    accessible-description: root.all ? "当前范围：全盘" : "当前范围：当前目录及子目录";
    clip: true;

    // 折叠态：单个切换按钮（范围名即文字），点击在两个范围间切换
    scope-compact := Rectangle {
        visible: root.compact;
        accessible-role: button;
        accessible-label: "搜索范围";
        accessible-value: root.all ? "全盘" : "当前目录及子目录";
        accessible-checkable: true;
        accessible-checked: root.all;
        accessible-action-default => {
            root.set-scope(!root.all);
        }

        compact-text := Text {
            text: root.all ? "全盘" : "目录";
            color: root.all ? Theme.accent : Theme.text;
            font-size: Theme.font-small;
            font-weight: root.all ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        compact-ta := TouchArea {
            enabled: root.compact;
            clicked => {
                root.set-scope(!root.all);
            }
        }
    }

    row := HorizontalLayout {
        visible: !root.compact;
        scope-seg-dir := Rectangle {
            width: root.compact ? 0px : dir-text.preferred-width + 20px;
            background: !root.all ? Theme.accent-soft : dir-ta.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: "范围：当前目录及子目录";
            accessible-checkable: true;
            accessible-checked: !root.all;
            accessible-action-default => {
                root.set-scope(false);
            }
            animate background { duration: 90ms; }

            dir-text := Text {
                text: "当前目录";
                color: !root.all ? Theme.accent : Theme.text;
                font-size: Theme.font-small;
                font-weight: !root.all ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            dir-ta := TouchArea {
                enabled: !root.compact;
                clicked => {
                    root.set-scope(false);
                }
            }
        }

        scope-seg-all := Rectangle {
            width: root.compact ? 0px : all-text.preferred-width + 20px;
            background: root.all ? Theme.accent-soft : all-ta.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: "范围：全盘";
            accessible-checkable: true;
            accessible-checked: root.all;
            accessible-action-default => {
                root.set-scope(true);
            }
            animate background { duration: 90ms; }

            all-text := Text {
                text: "全盘";
                color: root.all ? Theme.accent : Theme.text;
                font-size: Theme.font-small;
                font-weight: root.all ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            all-ta := TouchArea {
                enabled: !root.compact;
                clicked => {
                    root.set-scope(true);
                }
            }
        }
    }
}

// 范围切换按钮（互斥的两个）。
component ScopeChip inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();

    height: Theme.control-h;
    width: label.preferred-width + 24px;
    border-radius: Theme.control-h / 2;
    background: root.checked ? Theme.accent-soft : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-border : Theme.divider-strong;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: 90ms; }

    label := Text {
        text: root.text;
        color: root.checked ? Theme.accent : Theme.text;
        font-size: Theme.font;
        font-weight: root.checked ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SearchRow inherits Rectangle {
    in property <SearchItem> item;
    in property <int> index;
    callback pointer(int);
    callback activate(int);

    border-radius: 6px;
    background: root.item.selected ? Theme.accent-soft : ta.has-hover ? Theme.hover-soft : transparent;
    border-width: root.item.selected ? 1px : 0px;
    border-color: Theme.accent-border;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-description: root.item.location;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-item-index: root.index;
    accessible-action-default => {
        root.activate(root.index);
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer(root.index);
            }
        }
        double-clicked => {
            root.activate(root.index);
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: Theme.icon-s;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.item.icon;
                size: Theme.icon-s;
                line-width: 1.4px;
                tint: root.item.is-dir ? Theme.folder : Theme.text-secondary;
                fill-color: root.item.is-dir ? Theme.folder-fill : transparent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.item.name;
                color: root.item.missing ? Theme.text-disabled : Theme.text;
                font-size: Theme.font;
                overflow: elide;
            }

            Text {
                text: root.item.missing ? "已不存在，或所在磁盘已移除（搜索结果已过期）" : root.item.location;
                color: root.item.missing ? Theme.danger : Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
    }
}

// 搜索结果面板：范围切换、状态与能力说明、结果列表。覆盖在浏览面板区之上。
export component SearchPanel inherits Rectangle {
    in property <SearchView> v;
    in property <[SearchItem]> items;
    callback close();
    callback set-scope(bool);
    callback cancel();
    callback select(int);
    callback open(int);
    callback open-selected();
    callback locate();
    callback nav(int);

    public function focus-panel() {
        keys.focus();
    }

    property <length> row-h: Theme.row-h * 1.7;
    property <int> sel: root.v.selected;

    // 键盘移动选择时让选中行保持在可视范围内
    changed sel => {
        if (root.sel >= 0) {
            let top = root.sel * root.row-h;
            if (top < -results.content-y) {
                results.content-y = -top;
            } else if (top + root.row-h > -results.content-y + results.visible-height) {
                results.content-y = -(top + root.row-h - results.visible-height);
            }
        }
    }

    background: Theme.content-bg;
    accessible-role: groupbox;
    accessible-label: "搜索结果";
    accessible-description: root.v.status-text;

    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            if (e.text == Key.Return) {
                root.open-selected();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.nav(1);
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.nav(-1);
                return accept;
            }
            if (e.text == Key.PageDown) {
                root.nav(10);
                return accept;
            }
            if (e.text == Key.PageUp) {
                root.nav(-10);
                return accept;
            }
            if (e.text == Key.Home) {
                root.nav(-1000000);
                return accept;
            }
            if (e.text == Key.End) {
                root.nav(1000000);
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---------- 头部：范围、状态、能力 ----------
            Rectangle {
                background: Theme.chrome-bg;

                VerticalLayout {
                    padding: 12px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "搜索范围";
                            color: Theme.text-secondary;
                            font-size: Theme.font;
                            vertical-alignment: center;
                        }

                        search-scope-dir := ScopeChip {
                            text: "当前目录及子目录";
                            checked: !root.v.scope-all;
                            clicked => {
                                root.set-scope(false);
                            }
                        }

                        search-scope-all := ScopeChip {
                            text: "全盘";
                            checked: root.v.scope-all;
                            clicked => {
                                root.set-scope(true);
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.v.can-act: search-open := TextButton {
                            text: "打开";
                            clicked => {
                                root.open-selected();
                            }
                        }

                        if root.v.can-act: search-locate := TextButton {
                            text: "定位所在目录";
                            clicked => {
                                root.locate();
                            }
                        }

                        if root.v.phase == SearchPhase.scanning: search-cancel := TextButton {
                            text: "取消搜索";
                            clicked => {
                                root.cancel();
                            }
                        }

                        search-close := TextButton {
                            text: "关闭搜索";
                            clicked => {
                                root.close();
                            }
                        }
                    }

                    scope-label := Text {
                        text: root.v.scope-text;
                        color: Theme.text;
                        font-size: Theme.font;
                        overflow: elide;
                        accessible-role: text;
                        accessible-label: "搜索范围说明";
                        accessible-value: root.v.scope-text;
                    }

                    search-status := Text {
                        text: root.v.status-text;
                        color: root.v.phase == SearchPhase.unavailable ? Theme.danger : Theme.text-secondary;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: "搜索状态";
                        accessible-value: root.v.status-text;
                    }

                    search-backend := Text {
                        text: root.v.backend-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-small;
                        overflow: elide;
                        accessible-role: text;
                        accessible-label: "搜索能力";
                        accessible-value: root.v.backend-text;
                    }

                    if root.v.notice != SearchNotice.none: notice-bar := Rectangle {
                        height: notice-text.preferred-height + 12px;
                        border-radius: 6px;
                        background: root.v.notice == SearchNotice.warn ? #fdf3e1 : Theme.accent-soft;
                        accessible-role: text;
                        accessible-label: root.v.notice == SearchNotice.warn ? "搜索增强提示（警告）" : "搜索增强提示";
                        accessible-value: root.v.notice-text;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            Rectangle {
                                width: Theme.icon-s * 0.9;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    name: "warning";
                                    size: Theme.icon-s * 0.9;
                                    tint: root.v.notice == SearchNotice.warn ? Theme.warning : Theme.accent;
                                }
                            }

                            notice-text := Text {
                                horizontal-stretch: 1;
                                text: root.v.notice-text;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            // ---------- 结果 ----------
            Rectangle {
                vertical-stretch: 1;

                results := ListView {
                    accessible-label: "搜索结果列表";
                    for item[i] in root.items: SearchRow {
                        height: root.row-h;
                        item: item;
                        index: i;
                        pointer(idx) => {
                            keys.focus();
                            root.select(idx);
                        }
                        activate(idx) => {
                            root.open(idx);
                        }
                    }
                }

                if root.items.length == 0: empty-state := Rectangle {
                    accessible-role: groupbox;
                    accessible-label: root.v.phase == SearchPhase.scanning ? "正在搜索" : root.v.phase == SearchPhase.unavailable ? "搜索范围不可访问" : root.v.phase == SearchPhase.cancelled ? "搜索已取消" : "没有找到匹配项";

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        if root.v.phase == SearchPhase.scanning: progress := Rectangle {
                            height: 3px;
                            width: 120px;
                            border-radius: 2px;
                            background: Theme.divider;
                            accessible-role: progress-indicator;
                            accessible-label: "正在搜索";

                            Rectangle {
                                x: (parent.width - self.width) * (0.5 + 0.5 * Math.sin(360deg * mod(animation-tick() / 1.2s, 1)));
                                width: 40px;
                                height: parent.height;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                        }

                        Text {
                            text: root.v.phase == SearchPhase.scanning ? "正在扫描，尚未找到匹配项…" : root.v.phase == SearchPhase.unavailable ? "搜索范围不可访问" : root.v.phase == SearchPhase.cancelled ? "搜索已取消，尚未找到匹配项" : "没有找到匹配项";
                            color: Theme.text;
                            font-size: Theme.font-heading;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.v.phase == SearchPhase.done || root.v.phase == SearchPhase.empty ? "已扫描完成，请检查拼写，或用 .扩展名、path:路径 缩小或放宽条件；也可切换到“全盘”。" : root.v.status-text;
                            color: Theme.text-secondary;
                            font-size: Theme.font;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
