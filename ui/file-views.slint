// 文件视图：网格与列表。两者显示同一个条目模型，选择状态来自 Rust（FileItem.selected）。
// 两种视图都用 ListView 虚拟化：网格按行虚拟化，每行若干格；大目录只实例化可见行。
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { FileItem, SortKey, ThumbState, DragPhase, RenameBus } from "types.slint";

// 重命名输入框：Enter 确定、Esc 取消、失去焦点确定（与资源管理器一致）。
// 文本与选中范围通过 RenameBus 与 Rust 交换；原因非空时为红色边框。
component NameEditor inherits Rectangle {
    in property <TextHorizontalAlignment> align: left;
    property <bool> had-focus: false;
    height: Theme.font * 1.9;
    background: Theme.surface;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: RenameBus.error != "" ? Theme.danger : Theme.accent;

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                RenameBus.cancel();
                return accept;
            }
            reject
        }

        name-input := TextInput {
            x: 4px;
            width: parent.width - 8px;
            text <=> RenameBus.text;
            color: Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
            horizontal-alignment: root.align;
            single-line: true;
            selection-background-color: Theme.accent-border;
            selection-foreground-color: Theme.text;
            accessible-role: text-input;
            accessible-label: "重命名";
            init => {
                self.focus();
                self.set-selection-offsets(0, RenameBus.select-end);
            }
            accepted => {
                RenameBus.commit(self.text, false);
            }
            // 只有“先得到过焦点、后来失去”才算失去焦点提交（初始化时的 false 不算）
            changed has-focus => {
                if (self.has-focus) {
                    root.had-focus = true;
                } else if (root.had-focus) {
                    root.had-focus = false;
                    RenameBus.commit(self.text, true);
                }
            }
        }
    }
}

// 网格中缩略图格位的高度（不含文件名）。A2：图片本身是主体，格位比类型图标大；图标仍按 56px 显示。
export global GridMetrics {
    out property <length> thumb-h: 84px * min(Theme.text-scale, 1.5);
    out property <length> icon-h: 56px * min(Theme.text-scale, 1.5);
    out property <length> min-cell-w: 124px * Theme.text-scale;
}

// 网格中的一格：有缩略图时显示缩略图，否则显示类型图标（加载中为浅色占位）。
component GridCell inherits Rectangle {
    in property <FileItem> item;
    in property <int> index;
    in property <bool> is-cursor;
    in property <bool> pane-focused;
    // 所在视图是否显示：网格与列表同时实例化，只有显示着的那个才放重命名输入框（隐藏的输入框会抢走焦点）
    in property <bool> shown: true;
    callback pointer(int, bool, bool);
    callback activate(int);
    // 右键松开：请求这一项的右键菜单
    callback context(int);
    // 指针阶段（窗口逻辑坐标），Rust 用它识别拖放
    callback drag(int, DragPhase, length, length);

    border-radius: Theme.radius;
    background: root.item.drop-target ? Theme.accent-soft : root.item.selected ? (root.pane-focused ? Theme.accent-soft : Theme.inactive-select) : ta.has-hover ? Theme.hover-soft : transparent;
    border-width: (root.is-cursor && root.pane-focused) || root.item.selected || root.item.drop-target ? 1px : 0px;
    border-color: root.item.drop-target ? Theme.accent : root.is-cursor && root.pane-focused ? Theme.accent : Theme.accent-border;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-item-index: root.index;
    // 缩略图状态供无头测试读取（harness 按描述断言）
    accessible-description: root.item.thumb-state == ThumbState.loading ? "缩略图加载中" : root.item.thumb-state == ThumbState.ready ? "缩略图已显示" : root.item.thumb-state == ThumbState.failed ? "无法生成缩略图" : root.item.thumb-state == ThumbState.timeout ? "缩略图超时" : "";
    accessible-action-default => {
        root.activate(root.index);
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer(root.index, e.modifiers.control, e.modifiers.shift);
                root.drag(root.index, DragPhase.down, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.drag(root.index, DragPhase.up, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.kind == PointerEventKind.cancel) {
                root.drag(root.index, DragPhase.cancel, 0px, 0px);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.context(root.index);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag(root.index, DragPhase.move, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            root.activate(root.index);
        }
    }

    VerticalLayout {
        opacity: root.item.cut ? 0.45 : 1;
        padding: 8px;
        padding-top: 10px;
        spacing: 6px;

        thumb := Rectangle {
            height: GridMetrics.thumb-h;
            // 加载中：浅色圆角占位 + 浅色类型图标（静态，不做闪烁动画，避免整屏同时闪动）
            if root.item.thumb-state == ThumbState.loading: Rectangle {
                width: min(parent.width, GridMetrics.thumb-h * 1.25);
                height: parent.height;
                x: (parent.width - self.width) / 2;
                border-radius: 6px;
                background: Theme.hover-soft;
            }
            if root.item.thumb-state != ThumbState.ready: Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.item.icon;
                size: GridMetrics.icon-h;
                line-width: 1.3px;
                tint: root.item.is-dir ? Theme.folder : root.item.thumb-state == ThumbState.loading ? Theme.text-disabled : Theme.text-secondary;
                fill-color: root.item.is-dir ? Theme.folder-fill : transparent;
            }
            // 缩略图：完整显示（contain），不放大超过原始像素尺寸，居中
            if root.item.thumb-state == ThumbState.ready: thumb-image := Image {
                property <length> natural-w: root.item.thumb.width * 1px;
                property <length> natural-h: root.item.thumb.height * 1px;
                property <float> k: min(1, min(parent.width / max(1px, self.natural-w), parent.height / max(1px, self.natural-h)));
                width: self.natural-w * self.k;
                height: self.natural-h * self.k;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.item.thumb;
                image-fit: contain;
                accessible-role: none;
            }
        }

        if !(root.item.editing && root.shown): Text {
            text: root.item.name;
            color: Theme.text;
            font-size: Theme.font;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: char-wrap;
            overflow: elide;
            height: Theme.font * 2.8;
        }

        if root.item.editing && root.shown: Rectangle {
            height: Theme.font * 2.8;
            NameEditor {
                align: center;
            }
        }
    }
}

export component FileGrid inherits Rectangle {
    in property <[FileItem]> items;
    in property <int> cursor-index: -1;
    in property <bool> pane-focused;
    callback item-pointer(int, bool, bool);
    callback item-activate(int);
    callback background-pointer(bool);
    callback item-context(int);
    callback background-context();
    // 可见范围变化（滚动、尺寸、列数、条目数）：Rust 读取 visible-first／visible-end 并重排缩略图请求
    callback viewport-changed();
    callback item-drag(int, DragPhase, length, length);

    property <length> pad: 12px;
    property <length> scrollbar-reserve: 12px;
    property <length> min-cell-w: GridMetrics.min-cell-w;
    property <length> cell-h: GridMetrics.thumb-h + Theme.font * 2.8 + 30px;
    // 列数与一页的行数，供键盘移动使用
    out property <int> cols: max(1, floor((root.width - 2 * root.pad - root.scrollbar-reserve) / root.min-cell-w));
    out property <int> page-rows: max(1, floor((root.height - root.pad) / root.cell-h));
    property <length> cell-w: (root.width - 2 * root.pad - root.scrollbar-reserve) / root.cols;
    property <int> row-count: ceil(root.items.length / root.cols);
    // 可见（含半露出）项的下标范围 [visible-first, visible-end)，供缩略图调度使用
    out property <int> visible-first: min(root.items.length, max(0, floor((-lv.content-y - root.pad) / root.cell-h)) * root.cols);
    out property <int> visible-end: min(root.items.length, max(0, ceil((-lv.content-y + lv.visible-height - root.pad) / root.cell-h)) * root.cols);
    changed visible-first => {
        root.viewport-changed();
    }
    changed visible-end => {
        root.viewport-changed();
    }

    pure function row-top(i: int) -> length {
        return root.pad + floor(i / root.cols) * root.cell-h;
    }

    // 键盘移动后让光标项可见
    function ensure-visible(i: int) {
        if (i < 0) {
            return;
        }
        if (root.row-top(i) + lv.content-y < root.pad) {
            lv.content-y = root.pad - root.row-top(i);
            if (lv.content-y > 0) {
                lv.content-y = 0;
            }
        } else if (root.row-top(i) + root.cell-h + lv.content-y > lv.visible-height) {
            lv.content-y = lv.visible-height - root.row-top(i) - root.cell-h - root.pad / 2;
        }
    }

    changed cursor-index => {
        root.ensure-visible(root.cursor-index);
    }

    // 本控件内（相对坐标）某点落在哪一项上，没有则 -1。考虑了滚动位置。
    public pure function hit(lx: length, ly: length) -> int {
        if (ly - lv.content-y < root.pad || lx < root.pad) {
            return -1;
        }
        // 索引取整，先转成 int 再比较
        // 行、列
        if (Math.floor((lx - root.pad) / root.cell-w) >= root.cols) {
            return -1;
        }
        // 用整数运算得到条目序号
        // (ly - content-y - pad) / cell-h 是行号
        if (Math.floor((ly - lv.content-y - root.pad) / root.cell-h) * root.cols + Math.floor((lx - root.pad) / root.cell-w) >= root.items.length) {
            return -1;
        }
        return Math.floor((ly - lv.content-y - root.pad) / root.cell-h) * root.cols + Math.floor((lx - root.pad) / root.cell-w);
    }

    // 键盘（菜单键、Shift+F10）呼出右键菜单时的锚点：光标项中央，限制在可见区域内（相对本控件）
    public function anchor-x(i: int) -> length {
        return root.pad + mod(max(i, 0), root.cols) * root.cell-w + root.cell-w / 2;
    }

    public function anchor-y(i: int) -> length {
        return min(max(root.row-top(max(i, 0)) + lv.content-y + root.cell-h / 2, 8px), root.height - 8px);
    }

    lv := ListView {
        accessible-label: "文件网格";
        // 最后一行是填充行：让网格下方的空白处也能接收点击（清空选择）
        for r in root.row-count + 1: Rectangle {
            height: r < root.row-count ? (r == 0 ? root.cell-h + root.pad : root.cell-h) : max(0px, root.height - root.row-count * root.cell-h - root.pad);

            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.background-pointer(e.modifiers.control);
                    }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        root.background-context();
                    }
                }
            }

            for c in (r < root.row-count ? min(root.cols, root.items.length - r * root.cols) : 0): GridCell {
                x: root.pad + c * root.cell-w + 2px;
                y: (r == 0 ? root.pad : 0px) + 2px;
                width: root.cell-w - 4px;
                height: root.cell-h - 4px;
                item: root.items[r * root.cols + c];
                index: r * root.cols + c;
                is-cursor: root.cursor-index == r * root.cols + c;
                pane-focused: root.pane-focused;
                shown: root.visible;
                pointer(i, ctrl, shift) => {
                    root.item-pointer(i, ctrl, shift);
                }
                activate(i) => {
                    root.item-activate(i);
                }
                context(i) => {
                    root.item-context(i);
                }
                drag(i, phase, x, y) => {
                    root.item-drag(i, phase, x, y);
                }
            }
        }
    }
}

// 列表表头的一列，点击按该列排序。
component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <SortKey> key;
    in property <SortKey> sort-key;
    in property <bool> sort-ascending;
    in property <bool> align-right: false;
    callback sort-clicked(SortKey);

    background: ta.has-hover ? Theme.hover-soft : transparent;
    border-radius: 4px;
    accessible-role: button;
    accessible-label: "按" + root.text + "排序";
    accessible-checkable: true;
    accessible-checked: root.key == root.sort-key;
    accessible-action-default => {
        root.sort-clicked(root.key);
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        alignment: root.align-right ? end : start;

        Text {
            text: root.text;
            color: root.key == root.sort-key ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-small;
            font-weight: root.key == root.sort-key ? 600 : 400;
            vertical-alignment: center;
        }

        if root.key == root.sort-key: Rectangle {
            width: Theme.icon-s * 0.8;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.sort-ascending ? "arrow-up" : "arrow-down";
                size: Theme.icon-s * 0.8;
                tint: Theme.text-secondary;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.sort-clicked(root.key);
        }
    }
}

component ListRow inherits Rectangle {
    in property <FileItem> item;
    in property <int> index;
    in property <bool> is-cursor;
    in property <bool> pane-focused;
    in property <length> date-w;
    in property <length> kind-w;
    in property <length> size-w;
    // 所在视图是否显示（见 GridCell.shown）
    in property <bool> shown: true;
    callback pointer(int, bool, bool);
    callback activate(int);
    // 右键松开：请求这一项的右键菜单
    callback context(int);
    // 指针阶段（窗口逻辑坐标），Rust 用它识别拖放
    callback drag(int, DragPhase, length, length);

    border-radius: 6px;
    background: root.item.drop-target ? Theme.accent-soft : root.item.selected ? (root.pane-focused ? Theme.accent-soft : Theme.inactive-select) : ta.has-hover ? Theme.hover-soft : transparent;
    border-width: (root.is-cursor && root.pane-focused) || root.item.drop-target ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: root.item.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.item.selected;
    accessible-item-index: root.index;
    accessible-action-default => {
        root.activate(root.index);
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pointer(root.index, e.modifiers.control, e.modifiers.shift);
                root.drag(root.index, DragPhase.down, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                root.drag(root.index, DragPhase.up, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.kind == PointerEventKind.cancel) {
                root.drag(root.index, DragPhase.cancel, 0px, 0px);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.context(root.index);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag(root.index, DragPhase.move, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            root.activate(root.index);
        }
    }

    HorizontalLayout {
        opacity: root.item.cut ? 0.45 : 1;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: Theme.icon-s;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.item.icon;
                size: Theme.icon-s;
                line-width: 1.4px;
                tint: root.item.is-dir ? Theme.folder : Theme.text-secondary;
                fill-color: root.item.is-dir ? Theme.folder-fill : transparent;
            }
        }

        if !(root.item.editing && root.shown): Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: Theme.text;
            font-size: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.item.editing && root.shown: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            NameEditor { }
        }

        Text {
            width: root.date-w;
            text: root.item.date-text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: root.kind-w;
            text: root.item.kind-text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            width: root.size-w;
            text: root.item.size-text;
            color: Theme.text-secondary;
            font-size: Theme.font-small;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component FileList inherits Rectangle {
    in property <[FileItem]> items;
    in property <int> cursor-index: -1;
    in property <bool> pane-focused;
    in property <SortKey> sort-key;
    in property <bool> sort-ascending;
    // 回收站：“修改日期”列是删除日期，“类型”列是原位置（更宽）
    in property <bool> recycle: false;
    callback item-pointer(int, bool, bool);
    callback item-activate(int);
    callback background-pointer(bool);
    callback item-context(int);
    callback background-context();
    callback item-drag(int, DragPhase, length, length);
    callback sort-clicked(SortKey);

    property <length> date-w: 140px * Theme.text-scale;
    property <length> kind-w: (root.recycle ? 220px : 100px) * Theme.text-scale;
    property <length> size-w: 84px * Theme.text-scale;
    property <length> header-h: Theme.row-h;
    out property <int> page-rows: max(1, floor((root.height - root.header-h) / Theme.row-h));

    function ensure-visible(i: int) {
        if (i < 0) {
            return;
        }
        if (i * Theme.row-h + lv.content-y < 0) {
            lv.content-y = -i * Theme.row-h;
        } else if ((i + 1) * Theme.row-h + lv.content-y > lv.visible-height) {
            lv.content-y = lv.visible-height - (i + 1) * Theme.row-h;
        }
    }

    changed cursor-index => {
        root.ensure-visible(root.cursor-index);
    }

    // 本控件内（相对坐标）某点落在哪一行上，没有则 -1。考虑了滚动位置。
    public pure function hit(lx: length, ly: length) -> int {
        if (ly < root.header-h + 1px) {
            return -1;
        }
        if (Math.floor((ly - root.header-h - 1px - lv.content-y) / Theme.row-h) >= root.items.length) {
            return -1;
        }
        return Math.floor((ly - root.header-h - 1px - lv.content-y) / Theme.row-h);
    }

    // 键盘呼出右键菜单时的锚点：光标行，限制在可见区域内（相对本控件）
    public function anchor-x(i: int) -> length {
        return 72px;
    }

    public function anchor-y(i: int) -> length {
        return min(max(root.header-h + 1px + max(i, 0) * Theme.row-h + lv.content-y + Theme.row-h / 2, root.header-h + 8px), root.height - 8px);
    }

    VerticalLayout {
        HorizontalLayout {
            height: root.header-h;
            padding-left: 14px;
            padding-right: 26px;
            spacing: 8px;

            HeaderCell {
                horizontal-stretch: 1;
                text: "名称";
                key: SortKey.name;
                sort-key: root.sort-key;
                sort-ascending: root.sort-ascending;
                sort-clicked(k) => {
                    root.sort-clicked(k);
                }
            }

            HeaderCell {
                width: root.date-w;
                text: root.recycle ? "删除日期" : "修改日期";
                key: SortKey.modified;
                sort-key: root.sort-key;
                sort-ascending: root.sort-ascending;
                sort-clicked(k) => {
                    root.sort-clicked(k);
                }
            }

            HeaderCell {
                width: root.kind-w;
                text: root.recycle ? "原位置" : "类型";
                key: SortKey.kind;
                sort-key: root.sort-key;
                sort-ascending: root.sort-ascending;
                sort-clicked(k) => {
                    root.sort-clicked(k);
                }
            }

            HeaderCell {
                width: root.size-w;
                text: "大小";
                key: SortKey.size;
                align-right: true;
                sort-key: root.sort-key;
                sort-ascending: root.sort-ascending;
                sort-clicked(k) => {
                    root.sort-clicked(k);
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        lv := ListView {
            accessible-label: "文件列表";
            for i in root.items.length + 1: Rectangle {
                height: i < root.items.length ? Theme.row-h : max(0px, root.height - root.header-h - 1px - root.items.length * Theme.row-h);

                TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.background-pointer(e.modifiers.control);
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                            root.background-context();
                        }
                    }
                }

                if i < root.items.length: ListRow {
                    x: 6px;
                    width: parent.width - 18px;
                    height: parent.height;
                    item: root.items[i];
                    index: i;
                    is-cursor: root.cursor-index == i;
                    pane-focused: root.pane-focused;
                    shown: root.visible;
                    date-w: root.date-w;
                    kind-w: root.kind-w;
                    size-w: root.size-w;
                    pointer(idx, ctrl, shift) => {
                        root.item-pointer(idx, ctrl, shift);
                    }
                    activate(idx) => {
                        root.item-activate(idx);
                    }
                    context(idx) => {
                        root.item-context(idx);
                    }
                    drag(idx, phase, x, y) => {
                        root.item-drag(idx, phase, x, y);
                    }
                }
            }
        }
    }
}
